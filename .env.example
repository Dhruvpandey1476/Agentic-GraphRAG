# ============================================================
# TigerGraph  (Savanna: tgcloud.io  |  Community Edition: local)
# ============================================================
# Savanna: copy the "Domain" from your solution's detail page and
# prefix it with https://  (NO port — Savanna serves on 443).
#   TG_HOST=https://abcd1234.i.tgcloud.io
# Community Edition (local Docker):
#   TG_HOST=http://localhost
#   TG_GS_PORT=14240
#   TG_RESTPP_PORT=9000
TG_HOST=
TG_GRAPH=HackathonGraph
TG_USERNAME=tigergraph
TG_PASSWORD=
# Create under Savanna -> your solution -> Admin -> "Create secret".
# Preferred over password auth; leave blank to use TG_PASSWORD.
TG_SECRET=
TG_GS_PORT=
TG_RESTPP_PORT=
# Set to 1 to force the offline in-memory graph even if the above is set.
FORCE_MOCK_GRAPH=

# ============================================================
# LLM provider — one of: groq | openrouter | ollama | anthropic | openai
# ============================================================
LLM_PROVIDER=groq

# --- Groq (fast + generous free tier) -----------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b   # Groq retired the hosted Llama 3.x models

# --- OpenRouter (one key, many models) ----------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# --- Ollama (fully local, free, no key) ---------------------
# Start it with:  ollama serve  &&  ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Anthropic / OpenAI (optional) --------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# Embeddings — one of: tfidf | openai | ollama
#   tfidf  = zero-cost, corpus-fitted, needs no key  (default)
#   ollama = nomic-embed-text, local and free
# ============================================================
EMBEDDING_PROVIDER=tfidf
EMBEDDING_MODEL=text-embedding-3-small
# Vector search backend: local | tigergraph
VECTOR_BACKEND=local

# ============================================================
# Agent harness limits
# ============================================================
MAX_AGENT_STEPS=8
MAX_TOKENS_PER_RUN=20000
