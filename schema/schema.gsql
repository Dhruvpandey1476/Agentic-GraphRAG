// ============================================================
// Agentic GraphRAG Hackathon — graph schema
//
// Install with:  python -m scripts.setup_tigergraph --schema
// (or paste into GSQL Shell / Savanna's GSQL editor)
//
// Works on TigerGraph Savanna and Community Edition.
// ============================================================

// Statement order matters in GSQL: vertex and edge types are created at
// GLOBAL scope first, and CREATE GRAPH then declares which of them the
// graph contains. Creating the graph first and adding types to it
// afterwards requires a SCHEMA_CHANGE JOB and fails as a plain script.
//
// The DROP block makes re-running idempotent. On a fresh instance these
// drops fail because nothing exists yet — scripts/setup_tigergraph.py
// issues them separately and ignores that failure.

// Drop order matters as much as create order: edge types reference vertex
// types, so dropping vertices first fails with "used by another object" and
// leaves the old schema in place — which then makes the CREATEs fail too.
// Graph, then edges, then vertices.
DROP GRAPH HackathonGraph
DROP EDGE HAS_CHUNK, MENTIONS, RELATED_TO, IN_GAMES, IN_DISCIPLINE, GAMES_SEQUENCE
DROP VERTEX Document, Chunk, Entity, OlympicEvent, GamesEdition, Discipline

// ---- Generic RAG / free-form entity layer -----------------------------

CREATE VERTEX Document (
    PRIMARY_ID doc_id STRING,
    title STRING,
    source STRING,
    text STRING
) WITH primary_id_as_attribute="true"

CREATE VERTEX Chunk (
    PRIMARY_ID chunk_id STRING,
    doc_id STRING,
    text STRING,
    chunk_index INT,
    // Dense vector. Requires a dense embedding provider
    // (EMBEDDING_PROVIDER=ollama or openai) — TF-IDF produces sparse
    // vectors, which do not fit a LIST<DOUBLE>.
    embedding LIST<DOUBLE>
) WITH primary_id_as_attribute="true"

CREATE VERTEX Entity (
    PRIMARY_ID entity_id STRING,
    name STRING,
    entity_type STRING,
    description STRING,
    embedding LIST<DOUBLE>
) WITH primary_id_as_attribute="true"

// ---- Structured Olympic-event layer ------------------------------------
// Built deterministically (regex, no LLM) from the corpus's "[Infobox
// Olympic event]" blocks — see src/ingestion/infobox.py. This is the layer
// that lets the graph answer aggregation, superlative, temporal and lookup
// questions EXACTLY, instead of hoping an LLM counts correctly over
// retrieved prose.
//
// Note the *_search / discipline_norm mirror attributes. They exist because
// GSQL's LIKE is both case-sensitive AND plain substring containment, while
// the Python backend matches case-insensitively on WORD BOUNDARIES. Left
// alone, the same question returns different answers per backend: a query
// for "men's 20 kilometres walk" matches "women's 20 kilometres walk" under
// LIKE and returns the wrong medallist. The *_search columns hold the
// space-padded normalized form from infobox.search_key(), and the client
// pads the needle the same way, so LIKE gains word-boundary semantics and
// both backends agree by construction rather than by coincidence.

CREATE VERTEX OlympicEvent (
    PRIMARY_ID doc_id STRING,
    title STRING,
    url STRING,
    discipline STRING,
    discipline_norm STRING,
    event_name STRING,
    event_name_search STRING,
    games_id STRING,
    venue STRING,
    venues STRING,
    venue_search STRING,
    date STRING,
    date_search STRING,
    competitors INT,
    nations INT,
    teams INT,
    gold_name STRING,
    gold_noc STRING,
    silver_name STRING,
    silver_noc STRING,
    bronze_name STRING,
    bronze_noc STRING,
    win_value STRING
) WITH primary_id_as_attribute="true"

CREATE VERTEX GamesEdition (
    PRIMARY_ID games_id STRING,   // e.g. "2016-summer"
    year INT,
    season STRING,
    edition_index INT,            // global chronological order, for
                                  // "immediately before/after" queries
    prev_id STRING,
    next_id STRING
) WITH primary_id_as_attribute="true"

CREATE VERTEX Discipline (
    PRIMARY_ID name STRING
) WITH primary_id_as_attribute="true"

// ---- Edges --------------------------------------------------------------

CREATE UNDIRECTED EDGE HAS_CHUNK (FROM Document, TO Chunk)
CREATE UNDIRECTED EDGE MENTIONS (FROM Chunk, TO Entity, weight DOUBLE)
CREATE UNDIRECTED EDGE RELATED_TO (FROM Entity, TO Entity, relation_type STRING, weight DOUBLE, source_doc_id STRING)

CREATE UNDIRECTED EDGE IN_GAMES (FROM OlympicEvent, TO GamesEdition)
CREATE UNDIRECTED EDGE IN_DISCIPLINE (FROM OlympicEvent, TO Discipline)
CREATE DIRECTED EDGE GAMES_SEQUENCE (FROM GamesEdition, TO GamesEdition) WITH REVERSE_EDGE="GAMES_SEQUENCE_REVERSE"

// ---- Register everything on the graph -----------------------------------

CREATE GRAPH HackathonGraph (
    Document, Chunk, Entity, OlympicEvent, GamesEdition, Discipline,
    HAS_CHUNK, MENTIONS, RELATED_TO, IN_GAMES, IN_DISCIPLINE, GAMES_SEQUENCE
)
